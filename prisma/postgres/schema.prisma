generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String     @id @default(cuid())
  name              String
  email             String     @unique
  password          String?
  role              String     @default("USER")
  phone             String?
  size              String?
  active            Boolean    @default(true)
  preferences       String?
  notifications     String?
  mfaSecret         String?
  mfaEnabled        Boolean    @default(false)
  mfaSetupCompleted Boolean    @default(false)
  mfaRecoveryCodes  String?
  createdAt         DateTime   @default(now())
  wishlists         Wishlist[]
}

model AdminUser {
  id            String              @id @default(cuid())
  email         String              @unique
  name          String
  passwordHash  String
  role          String              @default("CONTENT_MANAGER") // SUPER_ADMIN | CONTENT_MANAGER
  mfaSecret     String?
  mfaEnabled    Boolean             @default(false)
  mfaLastUsedStep Int?              // last TOTP time step that authenticated this account (replay protection)
  suspended     Boolean             @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  sessions          AdminSession[]
  recoveryCodes     AdminRecoveryCode[]
  auditLogs         AdminAuditLog[]
  enquiries         Enquiry[]
  storefrontConfigs StorefrontConfig[]
  configHistories   StorefrontConfigHistory[]
  systemBackups     SystemBackup[]
}

model AdminSession {
  id           String    @id @default(cuid())
  adminId      String
  token        String    @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  admin        AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model AdminRecoveryCode {
  id        String    @id @default(cuid())
  adminId   String
  codeHash  String
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model AdminAuditLog {
  id           String     @id @default(cuid())
  adminId      String?
  action       String
  resourceType String
  resourceId   String?
  metadata     String?    // JSON metadata string
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime   @default(now())
  admin        AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
}

model Product {
  id                  String         @id @default(cuid())
  title               String
  sku                 String?        @unique
  price               Float
  promoPrice          Float?
  discount            Float?
  description         String
  craftsmanship       String?
  category            String
  gender              String
  featured            Boolean        @default(false)
  archived            Boolean        @default(false)
  isNewArrival        Boolean        @default(false)
  isBestSeller        Boolean        @default(false)
  isFestivalExclusive Boolean        @default(false)
  hidden              Boolean        @default(false)
  published           Boolean        @default(true)
  status              String         @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  material            String?
  colors              String?
  occasion            String?
  care                String?
  sizeGuide           String?
  sizes               String?
  collectionId        String?
  collection          Collection?    @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  images              ProductImage[]
  wishlists           Wishlist[]
  enquiries           Enquiry[]
  discounts           Discount[]
  createdAt           DateTime       @default(now())
}

model Collection {
  id           String    @id @default(cuid())
  title        String
  description  String?
  banner       String?
  thumbnail    String?
  displayOrder Int       @default(0)
  visible      Boolean   @default(true)
  status       String    @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED
  products     Product[]
  createdAt    DateTime  @default(now())
}

model Occasion {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  description  String?
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Category {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  description  String?
  image        String?
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Festival {
  id                 String      @id @default(cuid())
  name               String
  startDate          DateTime
  endDate            DateTime
  theme              String      // default | diwali | holi | eid | christmas | lohri | baisakhi
  enabled            Boolean     @default(false)
  status             String      @default("DRAFT") // DRAFT | SCHEDULED | ACTIVE | COMPLETED
  description        String?
  heroSubtitle       String?
  heroBanner         String?
  mediaAssetId       String?
  mediaAsset         MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  accentColor        String?     @default("#D4AF37")
  announcement       String?
  announcementActive Boolean     @default(true)
  animation          String?     @default("floating-diyas")
  effectIntensity    String?     @default("BALANCED") // SUBTLE | BALANCED | VIBRANT
  badgeText          String?
  offerHeading       String?
  offerDescription   String?
  ctaText            String?     @default("Explore Festive Collection")
  discountPercentage Float?
  discountScope      String?     @default("FESTIVAL_COLLECTION")
  productIds         String?     // JSON array string of featured product IDs
  autoActivate       Boolean     @default(true)
  autoDisable        Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @default(now()) @updatedAt
}

model Store {
  id            String   @id @default(cuid())
  name          String
  code          String?  @unique
  type          String   @default("FLAGSHIP")
  status        String   @default("OPEN") // OPEN | COMING_SOON | TEMPORARILY_CLOSED | DRAFT | ARCHIVED
  city          String
  state         String
  country       String   @default("India")
  street        String?
  pinCode       String?
  googleMapsUrl String?
  latitude      Float?
  longitude     Float?
  phone         String?
  email         String?
  managerName   String?
  whatsapp      String?
  openingHours  String?
  services      String?
  photos        String?
  description   String?
  accessibility String?
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("GENERAL")
  updatedAt DateTime @updatedAt
}

model Enquiry {
  id              String     @id @default(cuid())
  name            String
  email           String
  phone           String?
  size            String?
  color           String?
  subject         String?
  message         String?
  productSku      String?
  enquiryType     String?
  productId       String?
  product         Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  assignedAdminId String?
  assignedAdmin   AdminUser? @relation(fields: [assignedAdminId], references: [id], onDelete: SetNull)
  internalNotes   String?    // JSON array string of notes
  status          String     @default("NEW") // NEW | CONTACTED | IN_PROGRESS | COMPLETED | CLOSED
  createdAt       DateTime   @default(now())
}

model Discount {
  id                 String    @id @default(cuid())
  title              String
  percentage         Float?
  flatAmount         Float?
  startDate          DateTime
  endDate            DateTime
  promotionalBanner  String?
  featuredOnHomepage Boolean   @default(false)
  productId          String?
  product            Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  collectionId       String?
  categoryName       String?
  createdAt          DateTime  @default(now())
}

model Faq {
  id           String   @id @default(cuid())
  question     String
  answer       String
  category     String   @default("GENERAL")
  isPinned     Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

model CompanyContent {
  id        String   @id @default(cuid())
  key       String   @unique
  content   String
  status    String   @default("PUBLISHED")
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id         String   @id @default(cuid())
  name       String   @default("Untitled Asset")
  filename   String
  url        String
  altText    String?
  type       String   @default("IMAGE")
  folder     String   @default("branding")
  fileSize   String?
  dimensions String?
  status     String   @default("PUBLISHED")
  usedIn     String?
  isFavorite Boolean  @default(false)
  festivals  Festival[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
}

model StorefrontConfig {
  id             String     @id @default(cuid())
  page           String
  version        Int        @default(1)
  status         String     @default("DRAFT") // DRAFT | PUBLISHED
  sections       String     // JSON array of Section objects
  publishedAt    DateTime?
  lastEditedById String?
  lastEditedBy   AdminUser? @relation(fields: [lastEditedById], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([page, status])
}

model StorefrontConfigHistory {
  id             String     @id @default(cuid())
  page           String
  version        Int
  sections       String     // Snapshot of JSON array of Section objects
  publishedAt    DateTime   @default(now())
  publishedById  String?
  publishedBy    AdminUser? @relation(fields: [publishedById], references: [id], onDelete: SetNull)
  changelogNote  String?
  createdAt      DateTime   @default(now())

  @@index([page, version])
}

enum BackupStatus {
  PENDING
  VALID
  FAILED
  RESTORED
  SAFEGUARD
}

enum BackupType {
  MANUAL
  SCHEDULED
  SAFETY
}

model SystemBackup {
  id             String     @id @default(cuid())
  filename       String     @unique
  filePath       String
  fileSizeBytes  Int
  checksumSha256 String
  status         BackupStatus @default(PENDING) // PENDING, VALID, FAILED, RESTORED, SAFEGUARD
  type           BackupType @default(MANUAL)
  createdById    String?
  createdBy      AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
}
