# ==============================================================================
# Fashion Feet — Environment Configuration Template
# ==============================================================================

# Local development uses SQLite. Both Vercel projects must use the same managed
# PostgreSQL DATABASE_URL; Prisma migrations use the provider's direct URL.
DATABASE_URL="file:./dev.db"
DIRECT_URL=""

# Separate deployments. ADMIN_ORIGIN is set on the storefront project only;
# NEXT_PUBLIC_STOREFRONT_URL is set on the admin project.
ADMIN_ORIGIN="http://localhost:3001"
NEXT_PUBLIC_STOREFRONT_URL="http://localhost:3000"

# Contact and product enquiries are saved in PostgreSQL. When Resend is
# connected and mail.fashionfeet.co.in is verified, notifications are sent to
# aryan.kapoor@fashionfeet.co.in. Keep the API key server-side only.
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="Fashion Feet <enquiries@mail.fashionfeet.co.in>"

# Admin uploads on Vercel use a connected public Vercel Blob store. Its OIDC
# credentials are injected automatically when the store is connected.

# NextAuth / Auth.js Cryptographic Secret (min 32 characters)
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-32-char-cryptographically-secure-secret"
NEXTAUTH_SECRET="your-32-char-cryptographically-secure-secret"

# Auth.js URL (use https://fashionfeet.co.in on the production storefront)
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Admin session idle timeout, in minutes. A session that goes unused for this long
# is dropped even though its 12-hour absolute expiry has not passed. Leave unset to
# use the 30-minute default; a blank or non-numeric value also falls back to it.
# Note this cannot be set to 0 to disable the timeout — see docs/SecurityHardening.md §6.
ADMIN_IDLE_TIMEOUT_MINUTES="30"

# Initial Super Administrator Credentials (used only for one-time bootstrap).
# Never put these in a committed file or permanent deployment environment.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Node Runtime Environment
NODE_ENV="development"
PRISMA_CLIENT_ENGINE_TYPE="library"

# ==============================================================================
# Judy — the storefront assistant (src/lib/judy, POST /api/judy)
#
# Judy works with NO configuration at all. The default is offline mode: she
# answers from this site's own published content (FAQs, products, stores, the
# published homepage sections and the public appearance content) using
# deterministic keyword retrieval, and sends nothing to any third party.
#
# TODO(owner): an AI provider has NOT been chosen yet. Leave JUDY_PROVIDER as
# "offline" until one is. Choosing one is a two-line change here and nothing else.
# ==============================================================================

# "offline" (default) | "groq" | "gemini" | "openai"
# Any other value, or a remote provider with a missing/invalid configuration,
# silently and safely degrades to offline mode. Judy never errors and never
# fabricates an answer because of a configuration mistake.
JUDY_PROVIDER="offline"

# Credential for the selected remote provider. Server-side only — it has no
# NEXT_PUBLIC_ prefix, is never included in an API response and never reaches the
# browser. Leave blank while JUDY_PROVIDER="offline".
JUDY_API_KEY=""

# JUDY_MODEL IS REQUIRED FOR EVERY REMOTE PROVIDER — THERE IS NO DEFAULT HERE, ON
# PURPOSE. Model names change faster than this code will and a guessed id fails at
# run time with an opaque vendor error, so nothing is hard-coded. If
# JUDY_PROVIDER is remote and this is blank, Judy stays in offline mode.
#
# Take the exact id from the vendor's current model list:
#   OpenAI : https://platform.openai.com/docs/models
#   Groq   : https://console.groq.com/docs/models
#   Gemini : https://ai.google.dev/gemini-api/docs/models
# Example shape only (verify against the links above before use):
#   JUDY_MODEL="<exact model id from your provider's model list>"
JUDY_MODEL=""

# Optional: override the chat-completions endpoint. Defaults are the vendors'
# documented OpenAI-compatible endpoints:
#   openai -> https://api.openai.com/v1/chat/completions
#   groq   -> https://api.groq.com/openai/v1/chat/completions
#   gemini -> https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# Use this for a self-hosted OpenAI-compatible gateway. Either a base URL
# (e.g. https://my-gateway.example.com/v1) or a full /chat/completions URL.
JUDY_BASE_URL=""

# Optional: provider request timeout in milliseconds (1000-30000, default 10000).
# On timeout Judy logs the failure server-side and answers from the offline
# knowledge base instead.
JUDY_TIMEOUT_MS=""
