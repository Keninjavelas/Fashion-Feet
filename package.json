{
  "name": "fashion-feet",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/admin"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:admin": "npm run dev --workspace fashion-feet-admin",
    "build": "next build",
    "build:admin": "npm run build --workspace fashion-feet-admin",
    "build:vercel": "prisma generate --config prisma.postgres.config.ts && next build",
    "db:deploy:postgres": "prisma migrate deploy --config prisma.postgres.config.ts",
    "db:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "db:rotate-admin-password": "tsx scripts/rotate-admin-password.ts",
    "test:isolation": "node scripts/check-isolation.mjs",
    "start": "next start",
    "lint": "eslint",
    "test:acceptance": "npx tsx src/scripts/test-all-acceptance.ts",
    "test:gate2": "node src/scripts/run-gate-2-acceptance.js"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-libsql": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/three": "^0.186.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "otplib": "^13.4.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.0",
    "use-debounce": "^10.1.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "playwright": "^1.62.1",
    "prisma": "^7.10.1",
    "puppeteer-core": "^25.9.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
